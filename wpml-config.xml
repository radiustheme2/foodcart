<wpml-config>
    <admin-texts>
        <key name="foodcart">
            <key name="phone" />
            <key name="email" />
            <key name="address" />
            <key name="copyright_text" />
            <key name="error_title" />
            <key name="error_text1" />
            <key name="error_text2" />
            <key name="error_buttontext" />
        </key>
    </admin-texts>
    <custom-types>
        <custom-type translate="1">foodcart_team</custom-type>
        <custom-type translate="1">foodcart_recipe</custom-type>
        <custom-type translate="1">foodcart_gallery</custom-type>
        <custom-type translate="1">foodcart_testim</custom-type>
    </custom-types>
    <taxonomies>
        <taxonomy translate="1">foodcart_team_category</taxonomy>
        <taxonomy translate="1">foodcart_recipe_category</taxonomy>
        <taxonomy translate="1">foodcart_gallery_category</taxonomy>
        <taxonomy translate="1">foodcart_testimonial_category</taxonomy>
    </taxonomies>
    <custom-fields>
       <custom-field action="translate">foodcart_team_designation</custom-field>
       <custom-field action="translate">skill_name</custom-field>
       <custom-field action="translate">skill_value</custom-field>
       <custom-field action="translate">skill_color</custom-field>
       <custom-field action="translate">count_name</custom-field>
       <custom-field action="translate">count_value</custom-field>
	   
       <custom-field action="translate">foodcart_recipe_prep_time</custom-field>
       <custom-field action="translate">foodcart_recipe_cook_time</custom-field>
       <custom-field action="translate">foodcart_recipe_ready_in</custom-field>
       <custom-field action="translate">ingredient_item</custom-field>
       <custom-field action="translate">ingredient_quantity</custom-field>
       <custom-field action="translate">ingredient_unit</custom-field>
       <custom-field action="translate">nutritions_item</custom-field>
       <custom-field action="translate">foodcart_recipe_other</custom-field>
       <custom-field action="translate">foodcart_tes_designation</custom-field>
   </custom-fields>
</wpml-config>